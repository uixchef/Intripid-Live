# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files -- never commit real secrets (Mapbox token lives in .env.local)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
# ...but the checked-in template IS tracked:
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
Thumbs.db

# logs & caches
*.log
.eslintcache
.turbo/

# QA artifacts — screenshots are regenerated by qa/shoot.mjs
# Keep scripts (.mjs), ignore generated images
qa/screenshots/
qa/**/*.png
qa/**/*.jpg
qa/**/*.jpeg

# Product-report screenshots (25M, regenerated by capture-screens*.mjs)
docs/intripid-product-report/screenshots/
docs/intripid-product-report/contact-sheets/
docs/intripid-product-report/journeys/

# Design source files (not referenced by the product)
live/
.env*
